{
  "name": "athir-quran-radio",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/assets/config.js"
    ]
  },
  "build": {
    "command": "node scripts/build.mjs"
  }
}
